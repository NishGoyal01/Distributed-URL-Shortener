{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "src/main/resources/static",
  "routes": [
    {
      "src": "^/api/(.*)$",
      "dest": "${BACKEND_URL}/api/$1",
      "env": ["BACKEND_URL"]
    },
    {
      "src": "^/actuator/(.*)$",
      "dest": "${BACKEND_URL}/actuator/$1",
      "env": ["BACKEND_URL"]
    },
    {
      "src": "^/v3/api-docs(.*)$",
      "dest": "${BACKEND_URL}/v3/api-docs$1",
      "env": ["BACKEND_URL"]
    },
    {
      "src": "^/swagger-ui/(.*)$",
      "dest": "${BACKEND_URL}/swagger-ui/$1",
      "env": ["BACKEND_URL"]
    },
    {
      "src": "^/([A-Za-z0-9]+)$",
      "dest": "${BACKEND_URL}/$1",
      "env": ["BACKEND_URL"]
    }
  ]
}
