APP_IMAGE=linktrim:latest
PORT=8080
APP_BASE_URL=https://links.example.com

SPRING_DATASOURCE_URL=jdbc:postgresql://db.example.com:5432/urlshortener?sslmode=require
SPRING_DATASOURCE_USERNAME=replace-with-database-user
SPRING_DATASOURCE_PASSWORD=replace-with-database-password

SPRING_DATA_REDIS_HOST=redis.example.com
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=replace-with-redis-password
SPRING_DATA_REDIS_SSL_ENABLED=true

APP_CACHE_TTL_SECONDS=300
APP_RATE_LIMIT_MAX_REQUESTS=60
APP_RATE_LIMIT_WINDOW_SECONDS=60
